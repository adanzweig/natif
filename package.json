{
  "name": "benatif",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "pnpm -r --filter '!rules-tests' test",
    "test:rules": "pnpm --filter rules-tests test",
    "typecheck": "pnpm -r typecheck",
    "dev:checkin": "pnpm --filter web-checkin dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "5",
    "vitest": "^5.1.1",
    "zod": "4"
  }
}