# Builds libnatif_sd.so = stable-diffusion.cpp + Natif bridge + JNI, exporting only the JNI symbols.
cmake_minimum_required(VERSION 3.22)
project(natif_sd CXX C)
set(SD_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(SD_WEBP OFF CACHE BOOL "" FORCE)
set(SD_WEBM OFF CACHE BOOL "" FORCE)
set(GGML_OPENMP OFF CACHE BOOL "" FORCE)
set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
set(CMAKE_C_VISIBILITY_PRESET hidden)
set(CMAKE_CXX_VISIBILITY_PRESET hidden)
add_subdirectory(${SD_SRC} sd)
add_library(natif_sd SHARED ${BRIDGE}/natif_sd.cpp ${BRIDGE}/natif_sd_jni.cpp)
target_include_directories(natif_sd PRIVATE ${BRIDGE} ${SD_SRC}/include)
target_link_libraries(natif_sd PRIVATE stable-diffusion log)
target_link_options(natif_sd PRIVATE -Wl,--gc-sections -Wl,--exclude-libs,ALL -Wl,-z,max-page-size=16384)
