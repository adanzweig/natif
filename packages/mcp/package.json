{
  "name": "@be-natif/mcp",
  "version": "0.1.0",
  "description": "MCP server that helps AI coding assistants add on-device AI to apps with benatif.",
  "homepage": "https://benatif.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adanzweig/natif.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/adanzweig/natif/issues",
  "keywords": [
    "ai",
    "llm",
    "on-device",
    "local-ai",
    "webgpu",
    "llama.cpp",
    "react-native",
    "expo",
    "privacy",
    "json-schema"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "natif-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@be-natif/core": "workspace:^",
    "@types/node": "^26.6.6"
  }
}
